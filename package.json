{
	"name": "reader",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.9.1",
	"scripts": {
		"dev": "pnpm native && vite dev",
		"build:native": "mkdir -p bin && swiftc native/recognise/main.swift -o bin/recognise",
		"native": "[ bin/recognise -nt native/recognise/main.swift ] || pnpm build:native || echo 'Text recognition is off: the Mac helper (native/recognise) did not build.'",
		"dev:sandbox": "pnpm native && sqlite3 data/reader.db \".backup data/sandbox.db\" && SVELTEKIT_OUT_DIR=.svelte-kit-sandbox vite dev --mode sandbox",
		"build": "vite build",
		"preview": "vite preview",
		"start": "pnpm native && node serve.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:static": "knip && fallow dead-code && fallow architecture && fallow health --complexity --baseline .fallow-baselines/health.json --fail-on-baseline-growth --baseline-base HEAD && fallow dupes --baseline .fallow-baselines/dupes.json --fail-on-baseline-growth --baseline-base HEAD",
		"check:static:baseline": "fallow health --save-baseline .fallow-baselines/health.json; fallow dupes --save-baseline .fallow-baselines/dupes.json",
		"test:unit": "vitest",
		"test": "pnpm test:unit --run --project server",
		"mcp": "tsx src/lib/server/mcp/main.ts",
		"storybook": "storybook dev -p 6006 --ci",
		"build-storybook": "storybook build",
		"fixtures": "tsx src/fixtures/build.ts",
		"test:stories": "vitest --run --project stories",
		"test:visual": "VITE_VISUAL=1 vitest --run --project stories",
		"test:visual:update": "VITE_VISUAL=1 vitest --run --project stories --update"
	},
	"devDependencies": {
		"@storybook/addon-a11y": "11.0.0-beta.1",
		"@storybook/addon-themes": "11.0.0-beta.1",
		"@storybook/addon-vitest": "11.0.0-beta.1",
		"@storybook/sveltekit": "11.0.0-beta.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/better-sqlite3": "~9.6.0",
		"@types/node": "^22",
		"@vitest/browser": "4.1.12",
		"@vitest/browser-playwright": "4.1.12",
		"fallow": "^3.48.0",
		"knip": "^6.48.0",
		"playwright": "1.65.0",
		"storybook": "11.0.0-beta.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#fixtures": "./src/fixtures/index.ts",
		"#stories/*": "./src/stories/*"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "~1.32.2",
		"@mozilla/readability": "~0.6.0",
		"better-sqlite3": "~13.0.3",
		"kysely": "~0.29.7",
		"linkedom": "~0.18.14",
		"pinyin-pro": "~3.29.5",
		"ts-fsrs": "~5.4.2",
		"tsx": "~4.23.15",
		"zod": "~4.6.7"
	}
}
